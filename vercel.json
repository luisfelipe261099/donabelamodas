{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.8.0" },
    { "src": "website/index.php", "use": "vercel-php@0.8.0" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/website/img/(.*)", "dest": "/website/img/$1" },
    { "src": "/", "dest": "/index.php" }
  ]
}
